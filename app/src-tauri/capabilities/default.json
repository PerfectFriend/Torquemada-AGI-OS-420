{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults plus HTTP only to Anthropic, the Tor check endpoint and local services (Ollama, TTS engine).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.anthropic.com/*"
        },
        {
          "url": "http://127.0.0.1:*/*"
        },
        {
          "url": "http://localhost:*/*"
        },
        {
          "url": "https://check.torproject.org/*"
        }
      ]
    }
  ]
}